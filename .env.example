# ==============================================================================
# AI Resume Analyzer & Job Match System - Environment Configuration
# ==============================================================================
# NOTE: An API key is OPTIONAL!
# The application works 100% out of the box using built-in local NLP and TF-IDF similarity.
# If you wish to enable advanced generative AI analysis (executive summary,
# personalized suggestions, and interview questions), copy this file to .env and
# fill in your chosen API key below.
# ==============================================================================

# Option 1: Google Gemini API (Recommended, free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI API (Alternative, if you prefer GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Preferred LLM Provider ("gemini" or "openai"). Defaults to "gemini" if GEMINI_API_KEY is present.
LLM_PROVIDER=gemini
