# ==============================================================================
# .gitignore for AI Resume Analyzer
# ==============================================================================

# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg

# Virtual Environments & Secrets
.env
.env.*
!.env.example
.venv
venv/
ENV/
env/
env.bak/
venv.bak/

# SQLite Databases & Dynamic Persistence
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite
database/*.sqlite3

# Streamlit Configuration & Runtime Logs
.streamlit/secrets.toml
.streamlit/*.log

# Operating System & IDE Configuration
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Testing, Coverage, and Linting Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs and Temporary Scratch Files
*.log
scratch/
tmp/
temp/
