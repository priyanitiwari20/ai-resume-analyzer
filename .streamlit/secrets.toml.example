# ==============================================================================
# Streamlit Community Cloud Secrets Template
# ==============================================================================
# When deploying to Streamlit Community Cloud (https://share.streamlit.io):
# 1. Open your app settings dashboard
# 2. Go to the "Secrets" section
# 3. Paste the keys below (with your real API keys) and click "Save"
#
# Note: An API key is 100% OPTIONAL. If omitted, the app will seamlessly run in
# local rule-based NLP and TF-IDF similarity mode without any errors!
# ==============================================================================

# Google Gemini API Key (Recommended - Get from https://aistudio.google.com)
GEMINI_API_KEY = "your_google_gemini_api_key_here"

# OpenAI API Key (Alternative - Get from https://platform.openai.com)
OPENAI_API_KEY = "your_openai_api_key_here"

# Preferred AI Provider ("gemini" or "openai")
LLM_PROVIDER = "gemini"
